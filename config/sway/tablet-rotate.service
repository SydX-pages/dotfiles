[Unit]
Description=Tablet orientation auto-rotation for sway
PartOf=graphical-session.target

[Service]
Type=simple
Environment=SWAY_TABLET_ORIENT_OUTPUT=eDP-1
ExecStart=/usr/bin/python3 %h/.config/sway/tablet-rotate.py
ExecStopPost=/usr/bin/swaymsg output eDP-1 transform normal
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
