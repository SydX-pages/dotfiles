### 电源菜单（i3exit → swaylock / swaymsg / systemctl）
set $lock 'swaylock -f -c 1c1c22'

bindsym $mod+0 mode "system"
mode "system" {
    # 需要 swaylock 才能锁定
    bindsym l exec "$lock", mode "default"
    bindsym s exec "systemctl suspend", mode "default"
    bindsym h exec "systemctl hibernate", mode "default"
    bindsym u exec "swaymsg exit"
    bindsym e exec "swaymsg exit"
    bindsym r exec "systemctl reboot", mode "default"
    bindsym Shift+s exec "systemctl poweroff", mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# 电源键：直接挂起（--locked 让它在锁屏时也能用）
bindsym --locked XF86PowerOff exec "systemctl suspend"

# 熄屏 / 点亮
set $unblank ''

# 闲置 5 分钟 → 熄屏
# 唤醒（resume）时才锁屏：熄屏后没有任何事件会自己点亮屏幕，
# 必须等用户真的动鼠标/按键。唤醒瞬间就上锁，中间不闪内容。
# 事件名是 after-resume（连字符），写成 after_resume swayidle 会直接退出
#
# 注意：sway 由 sddm 启动，PATH 里没有 ~/.local/bin，所以这里必须写绝对路径，
# 否则 after-resume 只会得到 "x11-probe.sh: not found"（退出码 127），
# 而且因为 stderr 没有终端，看不到任何提示。
# after-resume 只在真正 suspend/resume（logind 的 PrepareForSleep）后触发；
# 只是 DPMS 熄屏再亮屏不会触发它，那种情况属于上面的 resume。

exec  swayidle -w \
        timeout 300 'swaylock -f -i /home/sydx/Pictures/WallPapers/wallhaven-yqkl97.jpg ' \
        timeout 300 'swaymsg "output * dpms off"' \
        resume 'swaymsg "output * dpms on"' \
        before-sleep 'swaylock -f -i /home/sydx/Pictures/WallPapers/wallhaven-yqkl97.jpg ' \
        after-resume '/home/sydx/.local/bin/x11-probe.sh'

