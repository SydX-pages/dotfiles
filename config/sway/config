### Input
# 参考 ~/.config/niri/config.kdl 的 touchpad 段：那边 natural-scroll 是关掉的，
# 这里之前误开了 natural_scroll，所以滚动方向是反的。
input type:touchpad {
    dwt enabled
    dwtp enabled
    tap enabled
    drag enabled
    natural_scroll disabled      # 若你其实想要"自然滚动"（内容跟着手指走）就改成 enabled
    middle_emulation enabled
    scroll_method two_finger
    pointer_accel 0.5            # = niri 的 accel-speed 0.6（这个 sway 只有 pointer_accel）
    scroll_factor 1
}
