{
	"custom/debian": {
		"format": "󰣚",
		"on-click": "rofi -show",
		"on-click-right": "foot -e sh -c 'fastfetch;zsh'",
		"tooltip": true,
		"tooltip-format": "Debian\n\nLeft-click: launcher (rofi)\nRight-click: fastfetch"
	},
	"idle_inhibitor": {
		"format": "{icon}",
		"format-icons": {
			"activated": "",
			"deactivated": ""
		}
	},

	"clock": {
		"format": " {:%H:%M:%S} ",
		"format-alt": "{:%Y-%m-%d %H:%M:%S}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "year",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#ffead3'><b>{}</b></span>",
				"days": "<span color='#ecc6d9'><b>{}</b></span>",
				"weeks": "<span color='#99ffdd'><b>W{}</b></span>",
				"weekdays": "<span color='#ffcc66'><b>{}</b></span>",
				"today": "<span color='#ff6699'><b><u>{}</u></b></span>"
			}
		},
		"interval": 1
	},
	"custom/weather": {
		"exec": "~/.config/waybar/scripts/weather/weather.sh",
		"format": "{}",
		"return-type": "json",
		"interval": 600,
		"tooltip": true,
		"on-click": "firefox --new-window https://wttr.in"
	},
	"privacy": {
		"icon-spacing": 4,
		"icon-size": 12,
		"transition-duration": 250,
		"modules": [
			{
				"type": "screenshare",
				"tooltip": true,
				"tooltip-icon-size": 24
			},
			{
				"type": "audio-out",
				"tooltip": true,
				"tooltip-icon-size": 24
			},
			{
				"type": "audio-in",
				"tooltip": true,
				"tooltip-icon-size": 24
			}
		]
	},
	"tray": {
		"icon-size": 14,
		"spacing": 10
	},
	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon}{volume}%{format_source} ",
		"format-bluetooth-muted": "{icon}{format_source} ",
		"format-muted": " {format_source} ",
		"format-source": "{volume}%",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				"󰕾",
				""
			]
		},
		"scroll-step": 0.15,
		"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
		"on-click-right": "pavucontrol"
	},
	"backlight": {
		"device": "backlight",
		"format": "{icon} {percent}% ",
		"format-icons": [
			"󱩎",
			"󱩏",
			"󱩑",
			"󱩒",
			"󱩓",
			"󱩔",
			"󱩖"
		],
		"scroll-step": 0.5,
		"tooltip": false,
		"on-click": "brightnessctl set 5%+",
		"on-click-right": "brightnessctl set 5%-"
	},
	"network": {
		"format-wifi": "{icon} {signalStrength}%",
		"format-ethernet": "󰈀 {ipaddr}",
		"format-linked": "{ifname} (No IP) 󰈀",
		"format-disconnected": "󰤮 offline",
		"format-icons": [
			"󰤯",
			"󰤟",
			"󰤢",
			"󰤥",
			"󰤨"
		],
		"tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ifname} · {ipaddr}\n↓{bandwidthDownBytes}  ↑{bandwidthUpBytes}\n\nLeft-click: nmtui\nRight-click: network editor",
		"tooltip-format-ethernet": "{ifname} · {ipaddr}\n↓{bandwidthDownBytes}  ↑{bandwidthUpBytes}\n\nLeft-click: nmtui\nRight-click: network editor",
		"tooltip-format-disconnected": "Disconnected\n\nLeft-click: nmtui\nRight-click: network editor",
		"on-click": "foot nmtui",
		"on-click-right": "nm-connection-editor"
	},
	"bluetooth": {
		"format": "󰂯",
		"format-connected": "󰂱 {num_connections}",
		"format-disabled": "󰂲",
		"format-off": "󰂲",
		"tooltip-format": "{controller_alias} · {controller_address}\n\nLeft-click: blueman\nRight-click: turn off",
		"tooltip-format-connected": "{controller_alias} · {controller_address}\n\nConnected devices ({num_connections}):\n{device_enumerate}\n\nLeft-click: blueman\nRight-click: turn off",
		"tooltip-format-enumerate-connected": "{device_alias} · {device_address}",
		"tooltip-format-enumerate-connected-battery": "{device_alias} · {device_address} · {device_battery_percentage}%",
		"tooltip-format-disabled": "Bluetooth off\n\nLeft-click: blueman\nRight-click: turn on",
		"tooltip-format-off": "Bluetooth off\n\nLeft-click: blueman\nRight-click: turn on",
		"on-click": "blueman-manager",
		"on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on"
	},
	"battery": {
		"states": {
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}% ",
		"format-full": "{icon} {capacity}% ",
		"format-charging": " {capacity}% ",
		"format-plugged": " {capacity}% ",
		"format-icons": [
			"󰁺",
			"󰁻",
			"󰁼",
			"󰁽",
			"󰁾",
			"󰁿",
			"󰂀",
			"󰂁",
			"󰂂",
			"󰁹"
		],
		"on-click": "pkill -SIGUSR1 -f 'waybar -c .*[b]at_bar'"
	},
	"custom/powerpolicy": {
		"format": "{text}",
		"exec": "/home/sydx/.config/waybar/scripts/PowerPolicy/cpustate.sh",
		"interval": 1,
		"on-click": "/home/sydx/.config/waybar/scripts/PowerPolicy/cpupower.sh",
		"tooltip": false
	},
	"custom/power": {
		"format": "⏻",
		"on-click": "~/.config/rofi/scripts/powermenu.sh",
		"tooltip": true,
		"tooltip-format": "Power menu\n\nLeft-click: open power menu"
	},
	"custom/notification": {
		"exec": "~/.config/waybar/scripts/notifications/count.sh",
		"format": "{text}",
		"return-type": "json",
		"interval": 2,
		"tooltip": true,
		"on-click": "makoctl restore",
		"on-click-right": "makoctl dismiss --all"
	},
	"custom/dnd": {
		"exec": "~/.config/waybar/scripts/notifications/dnd.sh",
		"format": "{text}",
		"return-type": "json",
		"interval": 2,
		"tooltip": true,
		"on-click": "makoctl mode -t do-not-disturb"
	},
	"sway/mode": {
		"format": "󰒉 {}",
		"tooltip": false
	},

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": false,
		"format": "{icon} {value}",
		"format-icons": {
			"urgent": "",
			"active": "",
			"default": ""
		}
	},
	"sway/window": {
		"format": "{}",
		"icon-size": 30,
		"max-length": 50
	}

}
