/* 电源菜单专用主题：不要用 launchpad.rasi（它是应用网格布局，rofi -dmenu 会错位） */
* {
    font: "JetBrainsMono Nerd Font 12";
    background-color: transparent;
    text-color: #c0caf5;
    border-color: #f92aad;
    selected-normal-background: #f92aad;
    selected-normal-foreground: #1b1e2e;
}

window {
    width: 280px;
    border: 2px;
    border-radius: 14px;
    background-color: #1b1e2eee;
    padding: 10px;
}

mainbox {
    spacing: 8px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 8px 12px;
    border-radius: 8px;
    background-color: #24283b;
    children: [ prompt, entry ];
}

prompt {
    text-color: #f92aad;
    margin: 0 8px 0 0;
}

entry {
    placeholder: "Select Option";
    text-color: #c0caf5;
}

listview {
    lines: 5;
    spacing: 4px;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 9px 12px;
    border-radius: 8px;
    background-color: transparent;
}

element selected {
    background-color: #f92aad;
    text-color: #1b1e2e;
}
